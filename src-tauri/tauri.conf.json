{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sainte Devote",
  "version": "1.7.0",
  "identifier": "dev.izumiz.sainte-devote",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sainte Devote",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 13
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../monacorc.json": "monacorc.json"
    }
  }
}
