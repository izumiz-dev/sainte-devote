{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sainte Devote",
  "version": "2.0.0",
  "identifier": "dev.izumiz.sainte-devote",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sainte Devote",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 13
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http: https:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A compact multi-tab Markdown editor.",
    "longDescription": "Sainte Devote is a compact multi-tab Markdown editor built around Monaco Editor.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../monacorc.json": "monacorc.json"
    }
  }
}
