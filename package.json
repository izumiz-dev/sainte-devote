{
  "name": "sainte-devote",
  "version": "2.0.1",
  "scripts": {
    "start": "pnpm tauri:dev",
    "dev": "pnpm tauri:dev",
    "build": "pnpm tauri:build",
    "build:mac": "pnpm tauri:build --bundles app,dmg",
    "build:win": "pnpm tauri:build --bundles nsis",
    "build:linux": "pnpm tauri:build --bundles appimage,deb",
    "lint": "pnpm lint:tauri",
    "lint:fix": "eslint frontend/src scripts/vendor.mjs scripts/verify-release-version.mjs --fix",
    "lint:tauri": "eslint frontend/src scripts/vendor.mjs scripts/verify-release-version.mjs --max-warnings 0",
    "check:tauri": "pnpm lint:tauri && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "vendor": "node scripts/vendor.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/vendor.mjs && tauri dev",
    "tauri:build": "node scripts/vendor.mjs && tauri build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "A compact Markdown editor built with Rust, Tauri 2, and Monaco Editor.",
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.4.11",
    "github-markdown-css": "^5.7.0",
    "marked": "^5.1.0",
    "monaco-editor": "^0.50.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
